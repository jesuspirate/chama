# chama-webpush-watcher — copy to .env, fill in, keep OUT of git.
# Generate the VAPID pair once:  npm run gen-vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:ops@chama.community

# Relays to watch (comma-separated). The community relay is enough; add public
# fallbacks if you want the watcher to survive a community-relay outage.
CHAMA_RELAYS=wss://relay.chama.community

# Loopback only — Caddy terminates TLS and proxies push.chama.community here.
BIND=127.0.0.1
PORT=8890

# Origins allowed to call /register (the app origins). CORS is enforced.
ALLOWED_ORIGINS=https://getchama.app,https://chama.community

# Where the opaque {endpoint -> tags} store is persisted (survives restarts).
STORE_PATH=./registrations.json
