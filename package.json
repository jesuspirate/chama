{
  "name": "satoshi-nostr-app",
  "private": true,
  "version": "3.6.0",
  "license": "MIT",
  "type": "module",
  "description": "Chama — Nostr-native P2P escrow client. Non-custodial. No server.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "test": "npx tsx src/escrow-engine/tests.ts",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run typecheck && npm test",
    "ship": "./scripts/ship.sh",
    "deploy:live": "./scripts/release.sh --deploy-live",
    "release:current": "./scripts/release.sh --current",
    "release:all": "./scripts/release-all.sh",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "tauri:sidecar": "./scripts/build-tauri-fedimint-bridge.sh"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.0.1",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@fedimint/core": "0.0.0-canary-cf43f9193627f8081b7144f7c057a7a112989031",
    "@fedimint/fedimint-client-wasm-bundler": "0.0.0-canary-cf43f9193627f8081b7144f7c057a7a112989031",
    "@fedimint/transport-web": "0.0.0-canary-cf43f9193627f8081b7144f7c057a7a112989031",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@types/qrcode": "^1.5.6",
    "cobe": "^2.0.1",
    "jsqr": "^1.4.0",
    "nostr-tools": "^2.23.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "shamir-secret-sharing": "^0.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.4.0",
    "vite-plugin-wasm": "^3.3.0"
  },
  "//security_overrides": "SECURITY: vite 5 ships esbuild <= 0.24.2 with GHSA-67mh-4wv8-2f99 (any website can request from the dev server and read responses) — exploitable on a dev box running `npm run dev` while browsing untrusted sites. The override below forces the patched esbuild even on vite 5. Vite 8 would also fix it, but vite-plugin-top-level-await@1.6 (latest) still requires rollup and pulls uuid@10.0.0 — it isn't compatible with vite 8's rolldown pipeline yet. Drop the override and bump vite to 8 once that plugin ships a rolldown-compatible release.",
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
