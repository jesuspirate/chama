{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chama",
  "version": "../package.json",
  "identifier": "app.chama.market",
  "build": {
    "beforeDevCommand": "npm run tauri:sidecar && npm run dev",
    "beforeBuildCommand": "npm run tauri:sidecar && npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Chama",
        "label": "main",
        "width": 430,
        "height": 860,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "externalBin": [
      "binaries/chama-fedimint-bridge"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "../public/icons/favicon-512x512.png",
      "../public/icons/favicon-256x256.png",
      "../public/icons/favicon-128x128.png",
      "../public/icons/favicon-32x32.png",
      "../public/icons/favicon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 180 },
        "applicationFolderPosition": { "x": 480, "y": 180 }
      }
    }
  }
}
