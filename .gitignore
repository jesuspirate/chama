design/
migration/
social/

# Vite transpiles vite.config.ts to a transient .mjs next to it while loading,
# then deletes it. If `git add -A` races that delete it aborts with
# "fatal: unable to stat '...timestamp-...mjs'". Ignore so add never sees them.
vite.config.ts.timestamp-*.mjs
*.timestamp-*.mjs

native/fedimint-bridge/target/
src-tauri/target/
src-tauri/binaries/chama-fedimint-bridge-*

# Per-release short notes shown in the Zapstore app card. Written by
# scripts/android-release.sh from --zapstore-notes-file before zsp
# publishes; treated as a build artifact, not source.
/zapstore/release-notes.md

# agent / build artifacts — not source
outputs/

