# Codex/agent working copies and transfer artifacts are never Chama source.
# Keep generated visual work in outputs/ (already ignored) until explicitly
# selected, optimized, and moved into a production asset directory.
.codex-vps-deploy/
.codex-target.patch
.b64tmp/

# Historical infrastructure/design work may be archived locally, but is not
# application source and must never return to the public repository.
design/
migration/
social/

# Vite transpiles vite.config.ts to a transient .mjs next to it while loading,
# then deletes it. If `git add -A` races that delete it aborts with
# "fatal: unable to stat '...timestamp-...mjs'". Ignore so add never sees them.
vite.config.ts.timestamp-*.mjs
*.timestamp-*.mjs

native/fedimint-bridge/target/
src-tauri/target/
src-tauri/binaries/chama-fedimint-bridge-*

# Per-release short notes shown in the Zapstore app card. Written by
# scripts/android-release.sh from --zapstore-notes-file before zsp
# publishes; treated as a build artifact, not source.
/zapstore/release-notes.md

# agent / build artifacts — not source
outputs/

# scratch dir (agent session) — not source
tmp/

# Generated image iterations are local working material by default. Existing
# reviewed assets remain tracked; promote a new production asset explicitly by
# adding it to landing/deploy-files.txt and staging it with `git add -f`.
/landing/img/**
/landing/icons/**
/public/icons/**

# Mutinynet bond live-attack harness — signet test keys (never commit)
scripts/.mutinynet-bond-keys.json

# Mutinynet commitment-bond harness — signet test key (never commit)
scripts/.mutinynet-commitment-keys.json

# Mutinynet commitment-bond adversarial verifier — signet test key (never commit)
scripts/.mutinynet-verify-keys.json

# brand-asset drafts — never deploy/bundle (the v5.0.0 APK-bloat lesson)
design/brand-assets/icons-archive/

# Internal VPS ops (friend-wallet bridge runbook) — infra detail, not app source.
# Kept on disk; never in the public tree.
scripts/remote-bridge/

# Agent-generated adoption log — artifact, not source.
chama-pulse-log.md

# Local agent memory + internal design briefs — NEVER pushed to the public repo
# (restored 2026-07-13 after the "clean public repository" cleanup removed them;
#  PHILOSOPHY/DECISIONS/INVARIANTS/BACKLOG restored 2026-07-25 from 7e4162c).
# Keep on disk for Claude/CC continuity; push only if explicitly needed.
# CLAUDE.md is the exception: as a StartOS package repo this tree ships the
# tracked one-line `@AGENTS.md` import every package carries.
Codex.md
PHILOSOPHY.md
DECISIONS.md
INVARIANTS.md
BACKLOG.md
design/mockups/

