<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         No theme-level android:background: a theme background applies to EVERY
         view inflated with the theme, including the pop-up windows Android uses
         for text-selection handles and the Copy/Paste bar, which then drew as
         black boxes with dark edges (Jet, GrapheneOS, 6.4.25 rc). The window
         and activity_main.xml set the dark background themselves. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#05050A</item>
        <item name="android:statusBarColor">#05050A</item>
        <item name="android:navigationBarColor">#05050A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#05050A</item>
        <item name="android:statusBarColor">#05050A</item>
        <item name="android:navigationBarColor">#05050A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/chama_splash</item>
        <item name="android:windowBackground">@drawable/chama_splash</item>
        <item name="windowSplashScreenBackground">@color/chama_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/chama_splash_mark_inset</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/chama_splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#05050A</item>
        <item name="android:navigationBarColor">#05050A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <!-- FloatingToolbar reads android:isLightTheme from the WebView/window
         context. Explicit overlays prevent the OS night mode overriding Chama. -->
    <style name="ChamaSelectionLight" parent="">
        <item name="android:isLightTheme">true</item>
        <item name="isLightTheme">true</item>
        <item name="android:actionModeStyle">@android:style/Widget.Material.Light.ActionMode</item>
        <item name="actionModeStyle">@style/Widget.AppCompat.ActionMode</item>
    </style>
    <style name="ChamaSelectionDark" parent="">
        <item name="android:isLightTheme">false</item>
        <item name="isLightTheme">false</item>
        <item name="android:actionModeStyle">@android:style/Widget.Material.ActionMode</item>
        <item name="actionModeStyle">@style/Widget.AppCompat.ActionMode</item>
    </style>
</resources>
